{
  "name": "@mcp-toolkit/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-toolkit-cli": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "node bin/run.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mcp-toolkit/core": "workspace:*",
    "@mcp-toolkit/model": "workspace:*",
    "@oclif/core": "^4.11.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mcp-toolkit/typescript-config": "workspace:*",
    "@mcp-toolkit/vitest-config": "workspace:*",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "oclif": {
    "bin": "mcp-toolkit-cli",
    "dirname": "mcp-toolkit",
    "commands": "./dist/commands",
    "topicSeparator": " "
  }
}
